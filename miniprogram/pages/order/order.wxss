.page {
  padding-bottom: 150rpx;
}

.hero {
  padding: 44rpx 32rpx 22rpx;
}

.eyebrow {
  display: block;
  color: #9d7b2a;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-top: 8rpx;
  color: #243127;
  font-size: 48rpx;
  font-weight: 800;
}

.sub {
  display: block;
  margin-top: 8rpx;
  color: #667467;
  font-size: 26rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #556b4e;
  font-size: 24rpx;
  font-weight: 700;
}

.top-gap {
  margin-top: 24rpx;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid rgba(74, 96, 76, 0.16);
  border-radius: 16rpx;
  background: #fff;
  padding: 22rpx;
  color: #243127;
  font-size: 28rpx;
}

.textarea {
  min-height: 150rpx;
}

.tag-scroll {
  margin-top: 24rpx;
  white-space: nowrap;
}

.tags {
  display: inline-flex;
  gap: 14rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  margin: 0;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #eef3e7;
  color: #556b4e;
  font-size: 24rpx;
  line-height: 1.4;
}

.tag.active {
  background: #647b5d;
  color: #fffdf8;
}

.menu {
  padding: 0 24rpx;
}

.dish {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(74, 96, 76, 0.12);
  border-radius: 18rpx;
  background: #fffdf8;
  box-shadow: 0 10rpx 24rpx rgba(74, 61, 41, 0.05);
}

.dish.selected {
  border-color: rgba(100, 123, 93, 0.38);
  background: #f5f8ef;
}

.dish-main {
  min-width: 0;
}

.dish-name {
  display: block;
  color: #243127;
  font-size: 32rpx;
  font-weight: 800;
}

.badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.badge {
  border-radius: 999rpx;
  background: #eef3e7;
  padding: 6rpx 14rpx;
  color: #556b4e;
  font-size: 22rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.round {
  width: 58rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #fff;
  color: #556b4e;
  font-size: 34rpx;
  line-height: 58rpx;
}

.qty {
  width: 38rpx;
  text-align: center;
  color: #243127;
  font-weight: 800;
}

.summary {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #243127;
  color: #fffdf8;
  box-shadow: 0 18rpx 42rpx rgba(36, 49, 39, 0.2);
}

.summary-title,
.summary-text {
  display: block;
}

.summary-title {
  font-size: 26rpx;
  font-weight: 800;
}

.summary-text {
  max-width: 430rpx;
  margin-top: 6rpx;
  overflow: hidden;
  color: rgba(255, 253, 248, 0.78);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submit {
  min-width: 150rpx;
  margin: 0;
  background: #d2935f;
  color: #fff;
}
